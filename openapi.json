{
 "openapi": "3.1.0",
 "info": {
  "title": "TopxAI API",
  "version": "2026-09-19",
  "summary": "One OpenAI- and Anthropic-compatible endpoint for Claude, GPT, Grok, GLM, Kimi and Jev.",
  "description": "TopxAI relays requests to the model providers at fixed USD prices on prepaid credit. The request body is forwarded unchanged and the response is returned unchanged; parameters not listed here pass through to the provider. Base URL for OpenAI-style SDKs: https://ai.topxea.com/v1. Base URL for the Anthropic SDK: https://ai.topxea.com. Prompts, completions and files are relayed in memory and never stored. Prices: https://ai.topxea.com/pricing and https://ai.topxea.com/api/pricing.",
  "termsOfService": "https://ai.topxea.com/user-agreement",
  "contact": {
   "name": "TopxAI support",
   "email": "support@topxea.com",
   "url": "https://ai.topxea.com/docs"
  },
  "x-logo": {
   "url": "https://ai.topxea.com/favicon.svg"
  },
  "license": {
   "name": "Terms of use",
   "url": "https://ai.topxea.com/user-agreement"
  }
 },
 "externalDocs": {
  "description": "Documentation",
  "url": "https://ai.topxea.com/docs"
 },
 "servers": [
  {
   "url": "https://ai.topxea.com",
   "description": "Production"
  }
 ],
 "security": [
  {
   "bearerAuth": []
  }
 ],
 "tags": [
  {
   "name": "OpenAI-compatible",
   "description": "Chat Completions, Responses, Images, Video and the model list, with Authorization: Bearer <key>."
  },
  {
   "name": "Anthropic-compatible",
   "description": "The Messages API for the Claude models, with x-api-key or Authorization: Bearer."
  },
  {
   "name": "TypeSafe",
   "description": "System One: typed questions about a state, answered with probabilities."
  },
  {
   "name": "Public",
   "description": "No key needed."
  }
 ],
 "paths": {
  "/v1/chat/completions": {
   "post": {
    "tags": [
     "OpenAI-compatible"
    ],
    "operationId": "createChatCompletion",
    "summary": "Chat Completions",
    "description": "OpenAI Chat Completions for every text model except Jev. GLM-5.3-Abliterated, kimi-k3, deepseek-flash and deepseek-v4-pro are served here only. Streaming with stream: true returns server-sent events.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ChatCompletionRequest"
       },
       "example": {
        "model": "claude-sonnet-5-5",
        "messages": [
         {
          "role": "user",
          "content": "Say hello in one sentence."
         }
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "The provider's chat completion, unchanged; usage carries the token counts the charge was settled from.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ChatCompletionResponse"
        }
       },
       "text/event-stream": {
        "schema": {
         "type": "string"
        }
       }
      }
     },
     "400": {
      "description": "The body failed validation; the message says which field.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "The key is missing or invalid.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "402": {
      "description": "The balance is empty.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "403": {
      "description": "The model is not sold here, is not on this key's route, or is excluded by the key's model limits.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "429": {
      "description": "Rate limited; Retry-After gives the wait in seconds.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "503": {
      "description": "No line can serve the model right now, or the provider is overloaded; retry.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
