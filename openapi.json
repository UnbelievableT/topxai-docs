  "/v1/messages": {
   "post": {
    "tags": [
     "Anthropic-compatible"
    ],
    "operationId": "createMessage",
    "summary": "Messages",
    "description": "Anthropic Messages API for the Claude models. Send the key as x-api-key (the Anthropic SDK does) or as a Bearer token; a raw request also needs anthropic-version and max_tokens. Prompt caching (cache_control) is forwarded and billed at the cache-read and cache-write prices.",
    "security": [
     {
      "anthropicKey": []
     },
     {
      "bearerAuth": []
     }
    ],
    "parameters": [
     {
      "name": "anthropic-version",
      "in": "header",
      "required": true,
      "schema": {
       "type": "string",
       "example": "2023-06-01"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/MessagesRequest"
       },
       "example": {
        "model": "claude-sonnet-5-5",
        "max_tokens": 256,
        "messages": [
         {
          "role": "user",
          "content": "Say hello in one sentence."
         }
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "The provider's message, unchanged.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true
        }
       },
       "text/event-stream": {
        "schema": {
         "type": "string"
        }
       }
      }
     },
     "400": {
      "description": "The body failed validation; the message says which field.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "The key is missing or invalid.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "402": {
      "description": "The balance is empty.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "403": {
      "description": "The model is not sold here, is not on this key's route, or is excluded by the key's model limits.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "429": {
      "description": "Rate limited; Retry-After gives the wait in seconds.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
