  "/v1/images/generations": {
   "post": {
    "tags": [
     "OpenAI-compatible"
    ],
    "operationId": "createImage",
    "summary": "Image generation",
    "description": "OpenAI Images for gpt-image-2.5-sunburst and gpt-image-2.5-flare. Billed per image: $0.03 at the 1K tier, $0.05 at the 2K tier, chosen from the pixel count of size (WIDTHxHEIGHT). n multiplies the fee and may be 1 to 128.",
