  "/v1/models": {
   "get": {
    "tags": [
     "OpenAI-compatible"
    ],
    "operationId": "listModels",
    "summary": "Models this key can call",
    "description": "The OpenAI model list, filtered to the models the key's route serves.",
    "responses": {
     "200": {
      "description": "The list.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "object": {
           "type": "string",
           "const": "list"
          },
          "data": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "id": {
              "type": "string"
             },
             "object": {
              "type": "string"
             },
             "owned_by": {
              "type": "string"
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "401": {
      "description": "The key is missing or invalid.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/api/pricing": {
   "get": {
    "tags": [
     "Public"
    ],
    "operationId": "getPricing",
    "security": [],
    "summary": "The price table",
    "description": "Every model with its route prices in USD (per 1M tokens, per image by size, per second by resolution), the routes it is enabled on, the endpoints that serve it, the provider's list price for comparison and the route an Auto-route key would pick. The same data as https://ai.topxea.com/pricing.",
    "responses": {
     "200": {
      "description": "The catalogue.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "data": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/PricingModel"
           }
          }
         }
        }
       }
      }
     },
     "429": {
      "description": "Rate limited; retry after the Retry-After seconds.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "bearerAuth": {
    "type": "http",
    "scheme": "bearer",
    "description": "A TopxAI API key (sk-...) as Authorization: Bearer <key>. Keys are created at https://ai.topxea.com/keys."
   },
   "anthropicKey": {
    "type": "apiKey",
    "in": "header",
    "name": "x-api-key",
    "description": "The same TopxAI key, the way the Anthropic SDK sends it."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "object",
      "properties": {
       "message": {
        "type": "string",
        "description": "Ends with a request id to quote to support@topxea.com."
       },
       "type": {
        "type": "string"
       },
       "code": {
        "type": [
         "string",
         "integer",
         "null"
        ]
       }
      }
     }
    }
   },
   "TextModel": {
    "type": "string",
    "description": "A catalogue text model.",
    "enum": [
     "claude-fable-5-1",
     "claude-sonnet-5-5",
     "claude-opus-5-5",
     "gpt-6-astra",
     "gpt-6.1-sol",
     "grok-4.7",
     "GLM-5.3-Abliterated",
     "kimi-k3",
     "deepseek-flash",
     "deepseek-v4-pro"
    ]
   },
   "ChatMessage": {
    "type": "object",
    "required": [
     "role",
     "content"
    ],
    "properties": {
     "role": {
      "type": "string",
      "enum": [
       "system",
       "developer",
       "user",
       "assistant",
       "tool"
      ]
     },
     "content": {
      "oneOf": [
       {
        "type": "string"
       },
       {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": true
        }
       }
      ],
      "description": "Text, or content parts (text, image_url) as the provider defines them."
     },
     "name": {
      "type": "string"
     },
     "tool_calls": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": true
      }
     },
     "tool_call_id": {
      "type": "string"
     }
    },
    "additionalProperties": true
   },
   "ChatCompletionRequest": {
    "type": "object",
    "required": [
     "model",
     "messages"
    ],
    "properties": {
     "model": {
      "$ref": "#/components/schemas/TextModel"
     },
     "messages": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/ChatMessage"
      }
     },
     "stream": {
      "type": "boolean",
      "default": false
     },
     "max_tokens": {
      "type": "integer"
     },
     "max_completion_tokens": {
      "type": "integer"
     },
     "temperature": {
      "type": "number"
     },
     "top_p": {
      "type": "number"
     },
     "tools": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": true
      }
     },
     "tool_choice": {},
     "response_format": {
      "type": "object",
      "additionalProperties": true
     },
     "reasoning_effort": {
      "type": "string"
     },
     "stop": {},
     "user": {
      "type": "string"
     }
    },
    "additionalProperties": true,
    "description": "OpenAI's Chat Completions body; fields not listed pass through to the provider."
   },
   "ChatCompletionResponse": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "object": {
      "type": "string"
     },
     "created": {
      "type": "integer"
     },
     "model": {
      "type": "string"
     },
     "choices": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": true
      }
     },
     "usage": {
      "$ref": "#/components/schemas/Usage"
     }
    },
    "additionalProperties": true
   },
   "Usage": {
    "type": "object",
    "properties": {
     "prompt_tokens": {
      "type": "integer"
     },
     "completion_tokens": {
      "type": "integer"
     },
     "total_tokens": {
      "type": "integer"
     },
     "prompt_tokens_details": {
      "type": "object",
      "properties": {
       "cached_tokens": {
        "type": "integer"
       }
      },
      "additionalProperties": true
     }
    },
    "additionalProperties": true
   },
   "ResponsesRequest": {
    "type": "object",
    "required": [
     "model",
     "input"
    ],
    "properties": {
     "model": {
      "type": "string",
      "enum": [
       "gpt-6-astra",
       "gpt-6.1-sol",
       "grok-4.7"
      ]
     },
     "input": {
      "oneOf": [
       {
        "type": "string"
       },
       {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": true
        }
       }
      ]
     },
     "instructions": {
      "type": "string"
     },
     "stream": {
      "type": "boolean"
     },
     "tools": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": true
      }
     },
     "reasoning": {
      "type": "object",
      "additionalProperties": true
     },
     "max_output_tokens": {
      "type": "integer"
     }
    },
    "additionalProperties": true
   },
   "MessagesRequest": {
    "type": "object",
    "required": [
     "model",
     "max_tokens",
     "messages"
    ],
    "properties": {
     "model": {
      "type": "string",
      "enum": [
       "claude-fable-5-1",
       "claude-sonnet-5-5",
       "claude-opus-5-5"
      ]
     },
     "max_tokens": {
      "type": "integer"
     },
     "messages": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "role",
        "content"
       ],
       "properties": {
        "role": {
         "type": "string",
         "enum": [
          "user",
          "assistant"
         ]
        },
        "content": {}
       },
       "additionalProperties": true
      }
     },
     "system": {
      "description": "A system prompt as a string or content blocks; TopxAI adds none of its own.",
      "oneOf": [
       {
        "type": "string"
       },
       {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": true
        }
       }
      ]
     },
     "stream": {
      "type": "boolean"
     },
     "tools": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": true
      }
     },
     "temperature": {
      "type": "number"
     },
     "thinking": {
      "type": "object",
      "additionalProperties": true
     }
    },
    "additionalProperties": true
   },
   "ImageRequest": {
    "type": "object",
    "required": [
     "model",
     "prompt"
    ],
    "properties": {
     "model": {
      "type": "string",
      "enum": [
       "gpt-image-2.5-sunburst",
       "gpt-image-2.5-flare"
      ]
     },
     "prompt": {
      "type": "string"
     },
     "size": {
      "type": "string",
      "description": "WIDTHxHEIGHT with a plain x; omitted or auto is pinned to 1024x1024. The pixel count picks the 1K or 2K tier.",
      "example": "1024x1024"
     },
     "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128,
      "default": 1
     },
     "quality": {
      "type": "string",
      "description": "Validated, does not change the fee."
     },
     "stream": {
      "type": "boolean"
     }
    },
    "additionalProperties": true
   },
   "VideoRequest": {
    "type": "object",
    "required": [
     "model",
     "prompt"
    ],
    "properties": {
     "model": {
      "type": "string",
      "const": "grok-imagine-video-1.5"
     },
     "prompt": {
      "type": "string"
     },
     "duration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15,
      "default": 8,
      "description": "Seconds of video; the fee is duration times the per-second price."
     },
     "resolution": {
      "type": "string",
      "enum": [
       "480p",
       "720p",
       "1080p"
      ],
      "default": "480p"
     },
     "image": {
      "description": "Image-to-video input, as xAI defines it."
     },
     "reference_images": {
      "type": "array",
      "items": {}
     },
     "aspect_ratio": {
      "type": "string"
     },
     "generate_audio": {
      "type": "boolean"
     }
    },
    "additionalProperties": true
   },
   "SystemOneQuestion": {
    "type": "object",
    "required": [
     "type"
    ],
    "properties": {
     "type": {
      "type": "string",
      "description": "noul (yes/no probability), choice (one of options) or score (a number in a range)."
     },
     "instructions": {
      "type": "string"
     },
     "options": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "min": {
      "type": "number"
     },
     "max": {
      "type": "number"
     }
    },
    "additionalProperties": true
   },
   "SystemOneRequest": {
    "type": "object",
    "required": [
     "model",
     "state",
     "questions"
    ],
    "properties": {
     "model": {
      "type": "string",
      "enum": [
       "jev-1.13.0",
       "jev-latest",
       "jev-preview"
      ]
     },
     "state": {
      "type": "string",
      "description": "The text the questions are about; at most 32k tokens plus the longest question."
     },
     "questions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
       "$ref": "#/components/schemas/SystemOneQuestion"
      }
     }
    },
    "additionalProperties": true
   },
   "SystemOneResponse": {
    "type": "object",
    "properties": {
     "model": {
      "type": "string"
     },
     "answers": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "additionalProperties": true
      }
     },
     "usage": {
      "type": "object",
      "properties": {
       "input_tokens": {
        "type": "integer"
       },
       "output_tokens": {
        "type": "integer"
       }
      }
     }
    },
    "additionalProperties": true
   },
   "RoutePrice": {
    "type": "object",
    "properties": {
     "unit": {
      "type": "string",
      "enum": [
       "per_million_tokens",
       "per_image",
       "per_second",
       "per_request"
      ]
     },
     "input": {
      "type": "number"
     },
     "output": {
      "type": "number"
     },
     "cache_read": {
      "type": "number"
     },
     "cache_write": {
      "type": "number"
     },
     "cache_write_1h": {
      "type": "number"
     },
     "long_context": {
      "type": "object",
      "properties": {
       "min_input_tokens": {
        "type": "integer"
       },
       "input": {
        "type": "number"
       },
       "output": {
        "type": "number"
       }
      },
      "additionalProperties": true
     },
     "sizes": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "resolutions": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "unit_price": {
      "type": "number"
     }
    },
    "additionalProperties": true
   },
   "PricingModel": {
    "type": "object",
    "properties": {
     "model_name": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "notice": {
      "type": "string"
     },
     "enable_groups": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "supported_endpoint_types": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "route_prices": {
      "type": "object",
      "additionalProperties": {
       "$ref": "#/components/schemas/RoutePrice"
      }
     },
     "reference_price": {
      "$ref": "#/components/schemas/RoutePrice"
     },
     "reference_price_source": {
      "type": "object",
      "properties": {
       "kind": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "url": {
        "type": "string"
       },
       "verified_at": {
        "type": "string"
       },
       "model": {
        "type": "string"
       }
      }
     },
     "auto_route": {
      "type": "string"
     },
     "context_window": {
      "type": "integer",
      "description": "Input context window in tokens; omitted when unknown or not applicable."
     },
     "max_output": {
      "type": "integer",
      "description": "Maximum output tokens; omitted when unknown or not applicable."
     }
    },
    "additionalProperties": true
   }
  }
 }
}
