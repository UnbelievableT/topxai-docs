     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ImageRequest"
       },
       "example": {
        "model": "gpt-image-2.5-flare",
        "prompt": "A lighthouse at dawn, watercolour",
        "size": "1024x1024",
        "n": 1
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "The provider's image response: data[] with url or b64_json.",
