  "/v1/videos/{request_id}": {
   "get": {
    "tags": [
     "OpenAI-compatible"
    ],
    "operationId": "getVideo",
    "summary": "Video job status",
    "description": "The provider's status document. pending, queued, processing, running and in_progress mean keep polling; done, failed and expired are final. Any key of the same account can poll.",
