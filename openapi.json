  "/v1/systemone": {
   "post": {
    "tags": [
     "TypeSafe"
    ],
    "operationId": "systemOne",
    "summary": "System One (Jev)",
    "description": "TypeSafe's System One: typed questions about a state, answered with probabilities instead of text. Models jev-1.13.0, jev-latest, jev-preview. $0.04494 per 1M input tokens, output free. /v1/system_one is accepted as a second spelling. The body must be at most 1 MiB with model, state and a non-empty questions object.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/SystemOneRequest"
       },
       "example": {
        "model": "jev-latest",
        "state": "I have asked three times now. Can I please just talk to a real person?",
        "questions": {
         "is_human_escalation": {
          "type": "noul",
          "instructions": "Is the customer asking for a human agent?"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "TypeSafe's answers, unchanged, with usage.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SystemOneResponse"
        },
        "example": {
         "model": "jev-latest",
         "answers": {
          "is_human_escalation": {
           "type": "noul",
           "noul": 0.99
          }
         },
         "usage": {
          "input_tokens": 43,
          "output_tokens": 0
         }
        }
       }
      }
     },
     "422": {
      "description": "TypeSafe's validation detail, as written.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "400": {
